GROQCLOUD_API_KEY=CHAVE_GROQ_AQUI
# Chaves opcionais de contingência. Nunca versione chaves reais.
GROQCLOUD_API_KEYS=
GROQCLOUD_API_KEY_2=
GROQCLOUD_API_KEY_3=

RAG_DEBUG_RETRIEVAL=false
GROQ_MODEL_NAME=openai/gpt-oss-120b
GROQ_TEMPERATURE=0
GROQ_REASONING_EFFORT=low
GROQ_MAX_TOKENS=800
GROQ_TPM_LIMIT=8000
GROQ_TPM_SAFETY_FACTOR=0.85

# Se o Tesseract não estiver no PATH do Windows, defina o executável.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

MAX_UPLOAD_BYTES=52428800
BENCHMARK_SEED=42
AUTO_SYNC_UPLOADS=false
EMBEDDING_OFFLINE=true
GROQ_TRUST_ENV=false
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
CHUNK_SIZE_WORDS=500
CHUNK_OVERLAP_WORDS=80
